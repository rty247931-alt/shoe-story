# انسخ هذا الملف باسم .env واملأ القيم قبل التشغيل على السيرفر الحقيقي
# cp .env.example .env

# رقم البورت اللي هيشتغل عليه السيرفر (منصات النشر زي Render بتحدده تلقائياً غالباً)
PORT=3000

# development | production
NODE_ENV=production

# مفتاح سري لتوقيع الـ JWT — لازم يكون طويل وعشوائي ومختلف تماماً عن أي مثال
# تقدر تولّد واحد بالأمر ده في التيرمنال:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# دومين الفرونت إند لو هتفصله عن السيرفر (اتركه فاضي لو الفرونت والباك على نفس الدومين)
CORS_ORIGIN=

# (اختياري) مسار مجلد تخزين البيانات والصور بشكل دائم — مفيد لو بتستخدم Persistent Disk
# على Render مثلاً. لو مش محدد، هيستخدم مجلد السيرفر العادي (server/data و server/uploads)
STORAGE_DIR=
